{
  "manifest_version": 2,
  "name": "Business Cats Strategy — Shop Mode (V3)",
  "version": "0.3.0",
  "description": "Сайдбар V3: переключаемые стратегии (V1 классическая, V2 profit-dominance), телеметрия и выгрузка логов.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "downloads",
    "*://*/*"
  ],
  "sidebar_action": {
    "default_title": "BC Shop Strategy V3",
    "default_panel": "ui/panel.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["content_script.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
