{
  "manifest_version": 2,
  "name": "Business Cats Strategy — Shop Mode (V3 Yandex)",
  "version": "0.3.0",
  "description": "V3: переключаемые стратегии (V1/V2), телеметрия и выгрузка логов.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "downloads",
    "*://*/*"
  ],
  "browser_action": {
    "default_title": "BC Shop Strategy V3",
    "default_popup": "ui/panel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_script.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
